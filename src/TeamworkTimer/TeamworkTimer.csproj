<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Proliminal.Sill.Plugins.TeamworkTimer</RootNamespace>
    <AssemblyName>TeamworkTimer</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Shown by Sill when it asks whether to load the plugin. -->
  <PropertyGroup>
    <Product>Teamwork timer</Product>
    <Company>Proliminal</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeamworkTimer.Tests" />
  </ItemGroup>

  <!-- Not copied: Sill loads plugins with its own SDK. -->
  <ItemGroup>
    <Reference Include="Proliminal.Sill.Sdk">
      <HintPath>$(SillSdk)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Debug builds install into Sill's plugins folder; -p:CopyToSill=false skips that. -->
  <Target Name="CopyToPluginsFolder" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(CopyToSill)' != 'false'">
    <ItemGroup>
      <_PluginFile Include="$(TargetDir)**\*" Exclude="$(TargetDir)Proliminal.Sill.Sdk.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFile)" DestinationFolder="$(APPDATA)\Proliminal\Sill\plugins\$(AssemblyName)\%(RecursiveDir)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
